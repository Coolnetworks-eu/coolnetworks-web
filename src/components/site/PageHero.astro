---
// Portado de components/site/PageHero.jsx
import Icon from '../Icon.astro';
import { images } from '../../content/site.js';
interface Action { label: string; to: string }
interface Props { kicker?: string; h1: string; lead?: string; image?: string; actions?: Action[] }
const { kicker, h1, lead, image, actions = [] } = Astro.props;
const src = image ? (images as Record<string, string>)[image] : null;
---
<section class="relative overflow-hidden bg-[hsl(var(--ink))] text-white">
  {src && <img src={src} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-20" />}
  <div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.07]"></div>
  <div class="relative mx-auto max-w-[72rem] px-6 py-16 sm:py-24">
    {kicker && <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-foreground/70">{kicker}</p>}
    <h1 class="mt-4 max-w-[44rem] font-display text-3xl font-semibold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-[2.9rem]">{h1}</h1>
    {lead && <p class="mt-6 max-w-[44rem] text-base leading-relaxed text-white/70 sm:text-lg">{lead}</p>}
    {actions.length > 0 && (
      <div class="mt-9 flex flex-wrap gap-3">
        {actions.map((action, index) => (
          <a href={action.to} class={index === 0
            ? 'inline-flex min-h-[48px] items-center gap-2 bg-white px-6 text-xs font-semibold uppercase tracking-[0.12em] text-[hsl(var(--ink))] transition-transform hover:bg-white/90 active:scale-[0.98]'
            : 'inline-flex min-h-[48px] items-center gap-2 border border-white/30 px-6 text-xs font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:border-white/70'}>
            {action.label}
            {index === 0 && <Icon name="arrow-right" class="h-4 w-4" />}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
