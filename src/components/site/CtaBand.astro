---
// Portado de components/site/CtaBand.jsx
import Icon from '../Icon.astro';
import { company } from '../../content/site.js';
interface Link { label: string; to: string }
interface Props { cta?: { title: string; text: string; primary?: Link; secondary?: Link } | null }
const { cta } = Astro.props;
---
{cta && (
  <section class="border-y border-border bg-secondary/60">
    <div class="mx-auto grid max-w-[72rem] gap-8 px-6 py-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div>
        <h2 class="font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))] text-balance sm:text-[1.75rem]">{cta.title}</h2>
        <p class="mt-3 max-w-[42rem] text-base leading-relaxed text-muted-foreground">{cta.text}</p>
        <div class="mt-5 flex flex-wrap gap-6 text-sm text-muted-foreground">
          <a href={company.phoneHref} class="inline-flex items-center gap-2 transition-colors hover:text-primary" data-analytics="phone-click"><Icon name="phone" class="h-4 w-4" strokeWidth={1.8} /> {company.phone}</a>
          <a href={`mailto:${company.email}`} class="inline-flex items-center gap-2 transition-colors hover:text-primary" data-analytics="email-click"><Icon name="mail" class="h-4 w-4" strokeWidth={1.8} /> {company.email}</a>
        </div>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        {cta.primary && (
          <a href={cta.primary.to} data-analytics="diagnostic-request" class="inline-flex min-h-[48px] items-center justify-center gap-2 bg-primary px-6 text-xs font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform hover:bg-primary/90 active:scale-[0.98]">
            {cta.primary.label}<Icon name="arrow-right" class="h-4 w-4" />
          </a>
        )}
        {cta.secondary && (
          <a href={cta.secondary.to} data-analytics="meeting-request" class="inline-flex min-h-[48px] items-center justify-center border border-border bg-card px-6 text-xs font-semibold uppercase tracking-[0.12em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary">
            {cta.secondary.label}
          </a>
        )}
      </div>
    </div>
  </section>
)}
