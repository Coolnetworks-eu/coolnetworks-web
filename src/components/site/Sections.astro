---
// Portado de components/site/Sections.jsx: pinta las secciones de una página de src/content/*.js.
// Tipos: text, list, grid, steps, links, note, faq.
import Icon from '../Icon.astro';
interface Props { sections?: any[] }
const { sections = [] } = Astro.props;
const known = new Set(['text', 'list', 'grid', 'steps', 'links', 'note', 'faq']);
const headingCls = 'font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))] sm:text-3xl';
const introCls = 'mt-3 max-w-[46rem] text-base leading-relaxed text-muted-foreground';
---
<div class="mx-auto max-w-[72rem] space-y-16 px-6 py-16 sm:space-y-20 sm:py-20">
  {sections.filter((s) => known.has(s.type)).map((s) => (
    <div data-reveal>
      <section>
        {s.type === 'text' && (
          <div class="grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-12">
            <h2 class={headingCls}>{s.title}</h2>
            <div class="space-y-4 text-[1.0625rem] leading-relaxed text-foreground/85">
              {s.body.map((p: string) => <p>{p}</p>)}
            </div>
          </div>
        )}
        {s.type === 'list' && (
          <div>
            <h2 class={headingCls}>{s.title}</h2>
            {s.intro && <p class={introCls}>{s.intro}</p>}
            <ul class="mt-8 grid gap-x-10 gap-y-0 sm:grid-cols-2">
              {s.items.map((item: string) => (
                <li class="flex gap-3 border-t border-border py-4 text-[0.95rem] leading-relaxed text-foreground/85">
                  <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-primary" strokeWidth={2.2} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {s.type === 'grid' && (
          <div>
            <h2 class={headingCls}>{s.title}</h2>
            {s.intro && <p class={introCls}>{s.intro}</p>}
            <div class="mt-8 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
              {s.items.map((item: any) => (
                <div class="bg-card p-6 transition-colors hover:bg-accent/40">
                  <h3 class="font-display text-base font-semibold text-[hsl(var(--ink))]">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}
        {s.type === 'steps' && (
          <div>
            <h2 class={headingCls}>{s.title}</h2>
            {s.intro && <p class={introCls}>{s.intro}</p>}
            <ol class="mt-8 space-y-0">
              {s.items.map((item: any, index: number) => (
                <li class="grid grid-cols-[3rem_1fr] items-start gap-4 border-t border-border py-5">
                  <span class="font-mono text-sm text-primary">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="font-display text-base font-semibold text-[hsl(var(--ink))]">{item.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}
        {s.type === 'links' && (
          <div>
            <h2 class={headingCls}>{s.title}</h2>
            {s.intro && <p class={introCls}>{s.intro}</p>}
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              {s.items.map((item: any) => (
                <a href={item.to} class="group flex items-start justify-between gap-4 border border-border bg-card p-5 transition-all hover:border-primary/60 hover:shadow-[0_16px_40px_-28px_hsl(220_40%_25%/0.5)] active:scale-[0.99]">
                  <span>
                    <span class="block font-display text-base font-semibold text-[hsl(var(--ink))]">{item.label}</span>
                    {item.text && <span class="mt-1 block text-sm leading-relaxed text-muted-foreground">{item.text}</span>}
                  </span>
                  <Icon name="arrow-right" class="mt-1 h-4 w-4 shrink-0 text-primary transition-transform duration-200 group-hover:translate-x-1" />
                </a>
              ))}
            </div>
          </div>
        )}
        {s.type === 'note' && (
          <div class="flex gap-4 border-l-2 border-primary bg-secondary/60 p-6">
            <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-primary" strokeWidth={1.8} />
            <div>
              <h2 class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-[hsl(var(--ink))]">{s.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-foreground/80">{s.text}</p>
            </div>
          </div>
        )}
        {s.type === 'faq' && (
          <div>
            <h2 class={headingCls}>{s.title}</h2>
            <dl class="mt-8">
              {s.items.map((item: any) => (
                <div class="border-t border-border py-5">
                  <dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">{item.q}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </section>
    </div>
  ))}
</div>
