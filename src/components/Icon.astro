---
// Iconos Lucide (los que usa el sitio), inline y sin dependencia en tiempo de ejecución.
// Para añadir uno: copiar el contenido del <svg> de lucide.dev a icons.json con su nombre kebab-case.
import icons from './icons.json';
interface Props { name: keyof typeof icons; class?: string; strokeWidth?: number; [k: string]: unknown }
const { name, class: cls = 'h-4 w-4', strokeWidth = 2, ...rest } = Astro.props;
if (!icons[name]) throw new Error(`Icono desconocido: ${name}`);
---
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" class={`lucide lucide-${name} ${cls}`} aria-hidden="true" {...rest} set:html={icons[name]} />
