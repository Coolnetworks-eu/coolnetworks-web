---
import Icon from './Icon.astro';
import nav from '../data/nav.json';
import { CONTACT } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="hidden border-b border-border/70 bg-[hsl(var(--ink))] text-[11px] uppercase tracking-[0.14em] text-white/70 lg:block">
    <div class="mx-auto flex max-w-[90rem] items-center justify-between px-6 py-2">
      <span>Ride the Secure Network — Zaragoza, España</span>
      <div class="flex items-center gap-6">
        <a href={CONTACT.phoneHref} class="transition-colors hover:text-white">{CONTACT.phone}</a>
        <a href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition-colors hover:text-white"><Icon name="message-circle" class="h-3.5 w-3.5" /> WhatsApp</a>
        <a href={`mailto:${CONTACT.email}`} class="transition-colors hover:text-white">{CONTACT.email}</a>
      </div>
    </div>
  </div>
  <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-4 px-6 py-3">
    <a class="flex items-center gap-3" href="/">
      <img src="/img/logo-coolnetworks.png" alt="Coolnetworks, icono de candado con circuito" class="h-10 w-10 object-contain" width="40" height="40" />
      <span class="font-display text-lg font-semibold tracking-tight text-[hsl(var(--ink))]">Cool<span class="text-primary">networks</span></span>
    </a>
    <nav class="hidden items-center xl:flex" aria-label="Navegación principal">
      {nav.map((group, i) => (
        <div class="relative" data-dropdown>
          <button type="button" class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground/75 transition-colors hover:text-primary" aria-expanded="false" aria-controls={`nav-panel-${i}`}>
            {group.label}<Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform duration-200" strokeWidth={2} />
          </button>
          <div id={`nav-panel-${i}`} hidden class="absolute left-0 top-full z-50 w-72 border border-border bg-card p-2 shadow-[0_18px_50px_-24px_hsl(220_40%_20%/0.45)]">
            {group.items.map((it) => (
              <a class="block rounded-sm px-3 py-2 text-sm text-foreground/80 transition-colors hover:bg-accent hover:text-accent-foreground" href={it.href}>{it.label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>
    <div class="hidden items-center gap-2 lg:flex">
      <a class="inline-flex items-center gap-2 border border-border px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary" href="/soporte"><Icon name="life-buoy" class="h-4 w-4" />Soporte clientes</a>
      <a data-analytics="diagnostic-request" class="inline-flex items-center bg-primary px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.1em] text-primary-foreground transition-transform hover:bg-primary/90 active:scale-[0.98]" href="/diagnosticos">Solicitar diagnóstico</a>
    </div>
    <button type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-mobile-open class="inline-flex h-11 w-11 items-center justify-center border border-border xl:hidden"><Icon name="menu" class="h-5 w-5" strokeWidth={2} /></button>
  </div>
</header>
<div id="mobile-menu" hidden class="fixed inset-0 z-[60] overflow-y-auto bg-background xl:hidden" role="dialog" aria-modal="true" aria-label="Menú">
  <div class="sticky top-0 flex items-center justify-between border-b border-border bg-background px-6 py-3">
    <a class="flex items-center gap-3" href="/">
      <img src="/img/logo-coolnetworks.png" alt="" class="h-10 w-10 object-contain" width="40" height="40" />
      <span class="font-display text-lg font-semibold tracking-tight text-[hsl(var(--ink))]">Cool<span class="text-primary">networks</span></span>
    </a>
    <button type="button" aria-label="Cerrar menú" data-mobile-close class="inline-flex h-11 w-11 items-center justify-center border border-border"><Icon name="x" class="h-5 w-5" strokeWidth={2} /></button>
  </div>
  <div class="px-6 pb-10 pt-2">
    {nav.map((group) => (
      <div class="border-b border-border/70 py-3">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{group.label}</p>
        <div class="grid gap-1">
          {group.items.map((it) => <a class="py-2 text-sm text-foreground/85" href={it.href}>{it.label}</a>)}
        </div>
      </div>
    ))}
    <div class="mt-5 grid gap-3">
      <a class="flex min-h-[44px] items-center justify-center gap-2 border border-border text-xs font-semibold uppercase tracking-[0.1em]" href="/soporte"><Icon name="life-buoy" class="h-4 w-4" />Soporte clientes</a>
      <a class="flex min-h-[44px] items-center justify-center bg-primary text-xs font-semibold uppercase tracking-[0.1em] text-primary-foreground" href="/diagnosticos">Solicitar diagnóstico</a>
    </div>
  </div>
</div>
