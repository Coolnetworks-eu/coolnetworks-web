---
// Importado del sitio Horizons (https://coolnetworks.it/recursos) el 2026-11-19.
// El contenido es HTML con clases de Tailwind: se edita aquí directamente.
import Layout from '../layouts/Layout.astro';
const meta = {
  "title": "Recursos | Blog, guías y webinars sobre IT, ciberseguridad e IA",
  "description": "Recursos de Coolnetworks. Blog, guías descargables y webinars sobre IT, ciberseguridad, compliance e Inteligencia Artificial.",
  "robots": "index, follow, max-image-preview:large",
  "ogImage": "/img/og-coolnetworks.jpg",
  "ld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://coolnetworks.eu"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Recursos",
          "item": "https://coolnetworks.eu/recursos"
        }
      ]
    }
  ]
};
---
<Layout {...meta} mainClass="flex-1">
<nav aria-label="Migas de pan" class="border-b border-border/70 bg-secondary/40"><ol class="mx-auto flex max-w-[72rem] flex-wrap items-center gap-1 px-6 py-3 text-xs text-muted-foreground"><li><a class="transition-colors hover:text-primary" href="/">Inicio</a></li><li class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3 w-3 shrink-0 opacity-60"><path d="m9 18 6-6-6-6"></path></svg><span aria-current="page" class="text-foreground/80">Recursos</span></li></ol></nav><section class="relative overflow-hidden bg-[hsl(var(--ink))] text-white"><img src="/img/430117de-1a64-450e-a5fd-99f1be65ebcd.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-20"><div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.07]"></div><div class="relative mx-auto max-w-[72rem] px-6 py-16 sm:py-24"><p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-foreground/70">Recursos</p><h1 class="mt-4 max-w-[44rem] font-display text-3xl font-semibold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-[2.9rem]">Recursos y artículos</h1><p class="mt-6 max-w-[44rem] text-base leading-relaxed text-white/70 sm:text-lg">Publicamos contenido técnico y de gestión escrito por quienes hacen el trabajo: criterios, checklists y explicaciones sin humo.</p></div></section><section class="mx-auto max-w-[72rem] px-6 py-16 sm:py-20"><h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">Categorías</h2><div class="mt-5 flex flex-wrap gap-2"><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">IT</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">Ciberseguridad</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">ISO 27001</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">ISO 9001</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">TISAX</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">ENS</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">PECAL</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">Inteligencia Artificial</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">Microsoft 365</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">Automatización</span><span class="border border-border px-3 py-1.5 text-xs text-foreground/75">Seguridad empresarial</span></div><div class="mt-10 grid gap-3 sm:grid-cols-3"><a class="border border-border bg-card p-6 transition-colors hover:border-primary" href="/recursos/blog"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Blog</h2><p class="mt-2 text-sm text-muted-foreground">Artículos periódicos por materia.</p></a><a class="border border-border bg-card p-6 transition-colors hover:border-primary" href="/recursos/guias"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Guías</h2><p class="mt-2 text-sm text-muted-foreground">Materiales descargables cuando existan.</p></a><a class="border border-border bg-card p-6 transition-colors hover:border-primary" href="/recursos/webinars"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Webinars</h2><p class="mt-2 text-sm text-muted-foreground">Sesiones y grabaciones reales.</p></a></div><div class="mt-12"><div class="border border-dashed border-border bg-secondary/40 p-8"><h2 class="font-display text-xl font-semibold text-[hsl(var(--ink))]">Primeros artículos en preparación</h2><p class="mt-3 max-w-[44rem] text-sm leading-relaxed text-muted-foreground">La sección está estructurada y lista para publicar de forma periódica. Cada artículo incluirá autor, fecha, categoría y datos estructurados de tipo Article. Mientras tanto, si tienes una duda concreta, plantéala directamente.</p><a class="mt-6 inline-flex min-h-[44px] items-center gap-2 bg-primary px-5 text-xs font-semibold uppercase tracking-[0.12em] text-primary-foreground" href="/empresa/contacto">Plantear una consulta <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section>
</Layout>
