4"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="group flex items-start justify-between gap-4 border border-border bg-card p-5 transition-all hover:border-primary/60 hover:shadow-[0_16px_40px_-28px_hsl(220_40%_25%/0.5)] active:scale-[0.99]" href="/ia/smart-helpdesk"><span><span class="block font-display text-base font-semibold text-[hsl(var(--ink))]">Smart Helpdesk</span><span class="mt-1 block text-sm leading-relaxed text-muted-foreground">Freshdesk + IA + base de conocimiento.</span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right mt-1 h-4 w-4 shrink-0 text-primary transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section></div><div class="" data-reveal><section><div><h2 class="font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))] sm:text-3xl">Preguntas frecuentes</h2><dl class="mt-8"><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Por dónde se empieza?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Por un diagnóstico de IA: dos o tres semanas para inventariar procesos candidatos, evaluar datos y seguridad, y priorizar casos de uso con estimación de retorno.</dd></div><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Nuestros datos salen de la empresa?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Depende de la arquitectura elegida. Diseñamos escenarios con control del dato, gestión de permisos y trazabilidad, y te explicamos las implicaciones de cada opción antes de decidir.</dd></div><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Hace falta tener los datos perfectos?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">No, pero sí saber dónde están y quién puede acceder. Parte del trabajo inicial consiste precisamente en ordenar esa base.</dd></div></dl></div></section></div></div><section class="border-y border-border bg-secondary/60"><div class="mx-auto grid max-w-[72rem] gap-8 px-6 py-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"><div><h2 class="font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))] text-balance sm:text-[1.75rem]">Solicitar diagnóstico de IA</h2><p class="mt-3 max-w-[42rem] text-base leading-relaxed text-muted-foreground">Empecemos por identificar los procesos donde la IA tiene sentido en tu empresa.</p><div class="mt-5 flex flex-wrap gap-6 text-sm text-muted-foreground"><a href="tel:+34621157500" class="inline-flex items-center gap-2 transition-colors hover:text-primary" data-analytics="phone-click"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone h-4 w-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> 621 15 75 00</a><a href="mailto:info@coolnetworks.it" class="inline-flex items-center gap-2 transition-colors hover:text-primary" data-analytics="email-click"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail h-4 w-4"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> info@coolnetworks.it</a></div></