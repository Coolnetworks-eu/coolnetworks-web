---
// Importado del sitio Horizons (https://coolnetworks.it/soporte) el 2026-11-19.
// El contenido es HTML con clases de Tailwind: se edita aquí directamente.
import Layout from '../layouts/Layout.astro';
const meta = {
  "title": "Soporte clientes | Coolnetworks",
  "description": "Soporte para clientes de Coolnetworks: abre una incidencia, consulta tus tickets, accede al portal Freshdesk, la base de conocimiento y las preguntas frecuentes.",
  "robots": "index, follow, max-image-preview:large",
  "ogImage": "/img/og-coolnetworks.jpg",
  "ld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://coolnetworks.eu"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Soporte clientes",
          "item": "https://coolnetworks.eu/soporte"
        }
      ]
    }
  ]
};
---
<Layout {...meta} mainClass="flex-1">
<nav aria-label="Migas de pan" class="border-b border-border/70 bg-secondary/40"><ol class="mx-auto flex max-w-[72rem] flex-wrap items-center gap-1 px-6 py-3 text-xs text-muted-foreground"><li><a class="transition-colors hover:text-primary" href="/">Inicio</a></li><li class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3 w-3 shrink-0 opacity-60"><path d="m9 18 6-6-6-6"></path></svg><span aria-current="page" class="text-foreground/80">Soporte clientes</span></li></ol></nav><section class="relative overflow-hidden bg-[hsl(var(--ink))] text-white"><div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.07]"></div><div class="relative mx-auto max-w-[72rem] px-6 py-16 sm:py-24"><p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-foreground/70">Soporte</p><h1 class="mt-4 max-w-[44rem] font-display text-3xl font-semibold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-[2.9rem]">Soporte clientes</h1><p class="mt-6 max-w-[44rem] text-base leading-relaxed text-white/70 sm:text-lg">Canal de atención para clientes con contrato de servicio. Cada solicitud queda registrada, priorizada y con seguimiento hasta su cierre.</p></div></section><section class="mx-auto max-w-[72rem] px-6 py-16 sm:py-20"><div class="grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2"><div class="bg-card p-7"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ticket h-6 w-6 text-primary"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path></svg><h2 class="mt-4 font-display text-lg font-semibold text-[hsl(var(--ink))]">Abrir incidencia</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Crea un ticket con la descripción del problema, el sistema afectado y su impacto.</p><a href="https://coolnetworks.freshdesk.com/support/tickets/new" target="_blank" rel="noopener noreferrer" data-analytics="freshdesk-access" class="mt-5 inline-flex min-h-[44px] items-center gap-2 border border-border px-4 text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary">Abrir en Freshdesk<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div><div class="bg-card p-7"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-6 w-6 text-primary"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg><h2 class="mt-4 font-display text-lg font-semibold text-[hsl(var(--ink))]">Consultar tickets</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Consulta el estado, el histórico y las respuestas de tus incidencias abiertas.</p><a href="https://coolnetworks.freshdesk.com/support/tickets" target="_blank" rel="noopener noreferrer" data-analytics="freshdesk-access" class="mt-5 inline-flex min-h-[44px] items-center gap-2 border border-border px-4 text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary">Ver mis tickets<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div><div class="bg-card p-7"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-life-buoy h-6 w-6 text-primary"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path><circle cx="12" cy="12" r="4"></circle></svg><h2 class="mt-4 font-display text-lg font-semibold text-[hsl(var(--ink))]">Portal de soporte</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Acceso completo al portal Freshdesk de Coolnetworks para clientes con contrato.</p><a href="https://coolnetworks.freshdesk.com" target="_blank" rel="noopener noreferrer" data-analytics="freshdesk-access" class="mt-5 inline-flex min-h-[44px] items-center gap-2 border border-border px-4 text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary">Acceder al portal<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div><div class="bg-card p-7"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open h-6 w-6 text-primary"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg><h2 class="mt-4 font-display text-lg font-semibold text-[hsl(var(--ink))]">Base de conocimiento</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Guías y procedimientos habituales: acceso remoto, correo, copias, dispositivos.</p><a href="https://coolnetworks.freshdesk.com/support/solutions" target="_blank" rel="noopener noreferrer" data-analytics="freshdesk-access" class="mt-5 inline-flex min-h-[44px] items-center gap-2 border border-border px-4 text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))] transition-colors hover:border-primary hover:text-primary">Ver artículos<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3.5 w-3.5"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></div><h2 class="mt-16 font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))]">Preguntas frecuentes de soporte</h2><dl class="mt-6"><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Cómo se priorizan las incidencias?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Por impacto y urgencia según el acuerdo de servicio: primero lo que detiene la actividad de la empresa o afecta a la seguridad.</dd></div><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Qué información debo incluir en el ticket?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Usuario y equipo afectado, hora de inicio, mensaje de error exacto, si afecta a más personas y qué se estaba haciendo cuando ocurrió.</dd></div><div class="border-t border-border py-5"><dt class="font-display text-base font-semibold text-[hsl(var(--ink))]">¿Puedo llamar directamente?</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Sí, para incidencias críticas. Aun así abrimos ticket para mantener el registro y la trazabilidad de las acciones.</dd></div></dl><div class="mt-14 border border-border bg-card p-7"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Contactar con soporte</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Si no puedes acceder al portal, escríbenos o llámanos y abrimos la incidencia por ti.</p><div class="mt-5 flex flex-wrap gap-6 text-sm"><a href="tel:+34621157500" data-analytics="phone-click" class="inline-flex items-center gap-2 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone h-4 w-4 text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> 621 15 75 00</a><a href="https://wa.me/34621157500" target="_blank" rel="noopener noreferrer" data-analytics="whatsapp-click" class="inline-flex items-center gap-2 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle h-4 w-4 text-primary"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg> WhatsApp +34 621 15 75 00</a><a href="mailto:info@coolnetworks.it" data-analytics="email-click" class="inline-flex items-center gap-2 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail h-4 w-4 text-primary"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> info@coolnetworks.it</a></div></div></section>
</Layout>
