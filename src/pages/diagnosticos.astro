---
// Importado del sitio Horizons (https://coolnetworks.it/diagnosticos) el 2026-11-19.
// El contenido es HTML con clases de Tailwind: se edita aquí directamente.
import Layout from '../layouts/Layout.astro';
const meta = {
  "title": "Diagnósticos empresariales | IT, ciberseguridad, compliance, IA",
  "description": "Diagnósticos gratuitos. Evaluamos tu situación en IT, ciberseguridad, compliance e IA. Solicita tu diagnóstico ahora.",
  "robots": "index, follow, max-image-preview:large",
  "ogImage": "/img/og-coolnetworks.jpg",
  "ld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://coolnetworks.eu"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Diagnósticos",
          "item": "https://coolnetworks.eu/diagnosticos"
        }
      ]
    }
  ]
};
---
<Layout {...meta} mainClass="flex-1">
<nav aria-label="Migas de pan" class="border-b border-border/70 bg-secondary/40"><ol class="mx-auto flex max-w-[72rem] flex-wrap items-center gap-1 px-6 py-3 text-xs text-muted-foreground"><li><a class="transition-colors hover:text-primary" href="/">Inicio</a></li><li class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3 w-3 shrink-0 opacity-60"><path d="m9 18 6-6-6-6"></path></svg><span aria-current="page" class="text-foreground/80">Diagnósticos</span></li></ol></nav><section class="relative overflow-hidden bg-[hsl(var(--ink))] text-white"><img src="/img/1f643670-e3ea-4d78-9b61-da262cc598bb.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-20"><div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.07]"></div><div class="relative mx-auto max-w-[72rem] px-6 py-16 sm:py-24"><p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-foreground/70">Diagnósticos</p><h1 class="mt-4 max-w-[44rem] font-display text-3xl font-semibold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-[2.9rem]">Empieza por saber dónde estás</h1><p class="mt-6 max-w-[44rem] text-base leading-relaxed text-white/70 sm:text-lg">Un diagnóstico inicial es la forma más rápida y económica de tomar decisiones tecnológicas con criterio. Elige el punto de partida que mejor encaja con tu situación.</p></div></section><section class="mx-auto max-w-[72rem] px-6 py-16 sm:py-20"><div class="grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2"><a class="group bg-card p-7 transition-colors hover:bg-accent/40" href="/diagnosticos/it"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Diagnóstico IT</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Revisamos el estado de tu infraestructura, tu soporte y tus copias, y te devolvemos un plan priorizado.</p><span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Solicitar<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="group bg-card p-7 transition-colors hover:bg-accent/40" href="/diagnosticos/ciberseguridad"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Diagnóstico de Ciberseguridad</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Medimos tu exposición real y te entregamos hallazgos priorizados por riesgo e impacto de negocio.</p><span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Solicitar<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="group bg-card p-7 transition-colors hover:bg-accent/40" href="/diagnosticos/compliance"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Diagnóstico de Compliance</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Aclaramos la certificación o marco objetivo y medimos tu madurez real frente a los requisitos.</p><span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Solicitar<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><a class="group bg-card p-7 transition-colors hover:bg-accent/40" href="/diagnosticos/ia-360"><h2 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Diagnóstico IA 360</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Identificamos dónde la IA puede ahorrar tiempo o coste en tu empresa, y dónde no conviene.</p><span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Solicitar<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div></section>
</Layout>
