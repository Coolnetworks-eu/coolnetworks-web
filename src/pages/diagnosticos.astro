          "inLanguage": "es-ES",
          "publisher": {
            "@id": "https://coolnetworks.eu/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://coolnetworks.eu/recursos/blog?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
