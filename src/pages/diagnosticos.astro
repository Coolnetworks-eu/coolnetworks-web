  "description": "Diagnósticos gratuitos. Evaluamos tu situación en IT, ciberseguridad, compliance e IA. Solicita tu diagnóstico ahora.",
  "robots": "index, follow, max-image-preview:large",
  "ogImage": "/img/og-coolnetworks.jpg",
  "ld": [
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": [
            "Organization",
            "LocalBusiness"
          ],
          "@id": "https://coolnetworks.eu/#organization",
          "name": "Coolnetworks",
          "legalName": "Miguel Rubira Garcia",
          "taxId": "34011693Y",
          "slogan": "Ride the Secure Network",
          "description": "Consultoría tecnológica especializada en IT, ciberseguridad, compliance (ISO 27001, TISAX, ENS, PECAL) e Inteligencia Artificial para empresas en Zaragoza y España.",
          "url": "https://coolnetworks.eu",
          "logo": {
            "@type": "ImageObject",
            "url": "https://coolnetworks.eu/img/logo-coolnetworks.png",
            "width": 400,
            "height": 100
          },
          "image": "https://coolnetworks.eu/img/logo-coolnetworks.png",
          "email": "info@coolnetworks.it",
          "telephone": "+34621157500",
          "contactPoint": [
            {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "telephone": "+34621157500",
              "email": "info@coolnetworks.it",
