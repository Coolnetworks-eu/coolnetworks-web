<Layout {...meta} mainClass="flex-1">
<section class="relative flex min-h-[100dvh] items-center overflow-hidden bg-[hsl(var(--ink))] text-white"><img src="/img/og-coolnetworks.webp" alt="Arquitectura de red y sistemas empresariales gestionados por Coolnetworks en Zaragoza" class="absolute inset-0 h-full w-full object-cover opacity-25" width="1600" height="900"><div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[hsl(var(--ink))] via-[hsl(var(--ink)/0.92)] to-[hsl(var(--ink)/0.55)]"></div><div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.08]"></div><div class="relative mx-auto w-full max-w-[90rem] px-6 py-24"><div class="max-w-[52rem]"><p class="inline-flex items-center gap-3 border border-white/20 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/80">Ride the Secure Network</p><h1 class="mt-8 font-display text-[2.1rem] font-semibold leading-[1.08] tracking-tight text-balance sm:text-5xl lg:text-[3.6rem]">Tecnología, Ciberseguridad, Compliance e IA para empresas</h1><p class="mt-7 max-w-[44rem] text-base leading-relaxed text-white/75 sm:text-lg">Servicios IT, protección, preparación para auditorías e Inteligencia Artificial para empresas en Zaragoza, Aragón y toda España.</p><div class="mt-10 flex flex-wrap gap-3"><a data-analytics="diagnostic-request" class="inline-flex min-h-[52px] items-center gap-2 bg-primary px-7 text-xs font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-colors hover:bg-[hsl(214_100%_55%)] active:scale-[0.98]" href="/diagnosticos">Solicitar diagnóstico <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a data-analytics="meeting-request" class="inline-flex min-h-[52px] items-center border border-white/30 px-7 text-xs font-semibold uppercase tracking-[0.12em] tex