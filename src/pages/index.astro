.5"></circle><circle cx="20" cy="8" r=".5"></circle></svg><h3 class="mt-6 font-display text-lg font-semibold text-[hsl(var(--ink))]">Inteligencia Artificial</h3><p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">Diagnóstico 360, automatización, agentes, RAG privada, integraciones, gobierno y Smart Helpdesk.</p><span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Ver área <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></span></a></div></div></div></section><section class="bg-secondary/70"><div class="mx-auto max-w-[72rem] px-6 py-20 sm:py-24"><div class="max-w-[46rem]"><p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-primary">Diagnósticos</p><h2 class="mt-4 font-display text-2xl font-semibold tracking-tight text-[hsl(var(--ink))] text-balance sm:text-[2rem]">Empieza midiendo, no adivinando</h2><p class="mt-4 text-base leading-relaxed text-muted-foreground">Cuatro puntos de entrada claros. Cada uno con un formulario breve y un plan de acción realista.</p></div><div class="mt-12 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2"><a class="group bg-card p-7 transition-colors hover:bg-background" href="/diagnosticos/it"><h3 class="font-display text-lg font-semibold text-[hsl(var(--ink))]">Diagnóstico IT</h3><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Infraestructura, soporte y copias con plan priorizado.</p><span class="mt-5 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary">Solicitar <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" st