---
// Importado del sitio Horizons (https://coolnetworks.it/empresa/contacto) el 2026-11-19.
// El contenido es HTML con clases de Tailwind: se edita aquí directamente.
import Layout from '../../layouts/Layout.astro';
const meta = {
  "title": "Contacto | Coolnetworks",
  "description": "Contacta con Coolnetworks. Teléfono, email y formulario de contacto. Ubicados en Zaragoza, servimos a empresas en toda España.",
  "robots": "index, follow, max-image-preview:large",
  "ogImage": "/img/og-coolnetworks.jpg",
  "ld": [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://coolnetworks.eu"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Empresa",
          "item": "https://coolnetworks.eu/empresa"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Contacto",
          "item": "https://coolnetworks.eu/empresa/contacto"
        }
      ]
    }
  ]
};
---
<Layout {...meta} mainClass="flex-1">
<nav aria-label="Migas de pan" class="border-b border-border/70 bg-secondary/40"><ol class="mx-auto flex max-w-[72rem] flex-wrap items-center gap-1 px-6 py-3 text-xs text-muted-foreground"><li><a class="transition-colors hover:text-primary" href="/">Inicio</a></li><li class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3 w-3 shrink-0 opacity-60"><path d="m9 18 6-6-6-6"></path></svg><a class="transition-colors hover:text-primary" href="/empresa">Empresa</a></li><li class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-3 w-3 shrink-0 opacity-60"><path d="m9 18 6-6-6-6"></path></svg><span aria-current="page" class="text-foreground/80">Contacto</span></li></ol></nav><section class="relative overflow-hidden bg-[hsl(var(--ink))] text-white"><div aria-hidden="true" class="grid-lines absolute inset-0 opacity-[0.07]"></div><div class="relative mx-auto max-w-[72rem] px-6 py-16 sm:py-24"><p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-primary-foreground/70">Empresa</p><h1 class="mt-4 max-w-[44rem] font-display text-3xl font-semibold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-[2.9rem]">Hablar con un especialista</h1><p class="mt-6 max-w-[44rem] text-base leading-relaxed text-white/70 sm:text-lg">Cuéntanos tu situación. En la primera conversación escuchamos, preguntamos y te decimos con honestidad si podemos ayudarte y cómo.</p></div></section><section class="mx-auto grid max-w-[72rem] gap-12 px-6 py-16 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] sm:py-20"><div class="space-y-8"><div><h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground">Datos de contacto</h2><div class="mt-5 space-y-4 text-sm"><a href="tel:+34621157500" data-analytics="phone-click" class="flex items-center gap-3 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone h-4 w-4 text-primary"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> 621 15 75 00</a><a href="https://wa.me/34621157500" target="_blank" rel="noopener noreferrer" data-analytics="whatsapp-click" class="flex items-center gap-3 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle h-4 w-4 text-primary"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg> WhatsApp +34 621 15 75 00</a><a href="mailto:info@coolnetworks.it" data-analytics="email-click" class="flex items-center gap-3 text-[hsl(var(--ink))] transition-colors hover:text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail h-4 w-4 text-primary"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg> info@coolnetworks.it</a><p class="flex items-center gap-3 text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin h-4 w-4 text-primary"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg> Zaragoza, España</p></div></div><div class="border-l-2 border-primary bg-secondary/60 p-5 text-sm leading-relaxed text-foreground/80"><p class="font-display font-semibold text-[hsl(var(--ink))]">¿Ya eres cliente?</p><p class="mt-2">Para incidencias técnicas usa el canal de soporte, con seguimiento y tiempos de respuesta acordados.</p><a class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-primary" href="/soporte">Soporte clientes <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div><div><h2 class="mb-5 font-display text-xl font-semibold tracking-tight text-[hsl(var(--ink))]">Solicitar reunión</h2><form novalidate="" class="border border-border bg-card p-6 sm:p-8" method="post" action="/api/contacto.php" data-cn-form="contacto"><input type="hidden" name="form" value="contacto"><input type="hidden" name="source_path" value=""><input type="hidden" name="ts" value=""><div class="grid gap-5 sm:grid-cols-2"><div class="flex flex-col gap-2 "><label for="contacto-company" class="text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))]">Empresa</label><input id="contacto-company" name="company" type="text" required="" maxlength="200" autocomplete="organization" class="min-h-[46px] border border-input bg-background px-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-primary" placeholder="Nombre de tu empresa"></div><div class="flex flex-col gap-2 "><label for="contacto-contact_name" class="text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))]">Nombre y apellidos</label><input id="contacto-contact_name" name="contact_name" type="text" required="" maxlength="200" autocomplete="name" class="min-h-[46px] border border-input bg-background px-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-primary" placeholder="Persona de contacto"></div><div class="flex flex-col gap-2 "><label for="contacto-email" class="text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))]">Correo profesional</label><input id="contacto-email" name="email" type="email" required="" maxlength="200" autocomplete="email" class="min-h-[46px] border border-input bg-background px-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-primary" placeholder="nombre@empresa.com"></div><div class="flex flex-col gap-2 "><label for="contacto-phone" class="text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))]">Teléfono</label><input id="contacto-phone" name="phone" type="tel" maxlength="60" autocomplete="tel" class="min-h-[46px] border border-input bg-background px-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-primary" placeholder="Opcional"></div><div class="flex flex-col gap-2 sm:col-span-2"><label for="contacto-situation" class="text-xs font-semibold uppercase tracking-[0.1em] text-[hsl(var(--ink))]">¿Qué necesitas resolver?</label><textarea id="contacto-situation" name="situation" rows="4" maxlength="4000" class="border border-input bg-background p-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/70 focus:border-primary" placeholder="Cuéntanos brevemente tu situación y qué necesitas resolver."></textarea></div></div><input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="pointer-events-none absolute h-0 w-0 opacity-0"><label class="mt-6 flex items-start gap-3 text-xs leading-relaxed text-muted-foreground"><input type="checkbox" name="consent" required="" class="mt-0.5 h-4 w-4 shrink-0 accent-[hsl(var(--primary))]"><span>Acepto el tratamiento de mis datos para atender esta solicitud, según la política de privacidad.</span></label><button type="submit" data-analytics="form-submit" class="mt-6 inline-flex min-h-[48px] w-full items-center justify-center gap-2 bg-primary px-6 text-xs font-semibold uppercase tracking-[0.12em] text-primary-foreground transition-transform hover:bg-primary/90 active:scale-[0.98] disabled:opacity-70 sm:w-auto">Solicitar reunión</button><p class="mt-4 flex items-center gap-2 text-[11px] text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check h-3.5 w-3.5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>Datos tratados de forma confidencial. Sin spam comercial.</p><p data-cn-form-error class="mt-4 hidden text-sm text-destructive" role="alert"></p></form></div></section>
</Layout>
